{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "w-lst-paginas",
  "main": "src/index.js",
  "compatibility_date": "2026-04-22",
  "account_id": "21e4875f53338100ee74196613471f21",
  "assets": {
    // Static-assets deploys replace the entire shared collection. This invalid
    // path makes accidental Wrangler deploys fail before they can remove pages.
    "directory": "./__STATIC_ASSET_DEPLOY_BLOCKED__",
    "binding": "ASSETS"
  },
  "kv_namespaces": [{ "binding": "INSCRICOES", "id": "240a7a010d6b468ca86e35fa97393712" }],
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  // Sentinela: SENTINELA_TAG "1" injeta a tag no <head> de todo HTML; "0" desliga (só trocar e fazer deploy).
  "vars": { "SENTINELA_TAG": "0", "SENTINELA_TID": "faafca5a-fb53-404f-8469-499d8869944c" },
  "routes": [
    "leandrostecca.com.br/p/*",
    "www.leandrostecca.com.br/p/*"
  ]
}
