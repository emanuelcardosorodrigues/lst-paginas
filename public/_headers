# Cache headers para DPL-PV01

# HTML - curto cache para permitir atualizações rápidas
/dpl-pv01/
  Cache-Control: public, max-age=0, must-revalidate, s-maxage=60
  X-Content-Type-Options: nosniff

# Recursos estáticos - cache longo imutável
/dpl-pv01/images/*
  Cache-Control: public, max-age=31536000, immutable
  X-Content-Type-Options: nosniff

/dpl-pv01/assets/*
  Cache-Control: public, max-age=31536000, immutable
  X-Content-Type-Options: nosniff

/dpl-pv01/third-party.js
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800
  X-Content-Type-Options: nosniff

# Fonts - cache longo
/dpl-pv01/fonts/*
  Cache-Control: public, max-age=31536000, immutable

# ── plo-pv01 (mantido para compatibilidade) ─────────────────
# Hashed assets (JS/CSS with content hash) — immutable 1 year
/plo-pv01/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Images — 1 year with stale-while-revalidate
/plo-pv01/images/*
  Cache-Control: public, max-age=31536000, stale-while-revalidate=86400

# HTML — short cache for tracking pixels
/plo-pv01/
  Cache-Control: public, max-age=300, s-maxage=600, stale-while-revalidate=60
  X-Content-Type-Options: nosniff
  X-Frame-Options: SAMEORIGIN

# robots.txt
/plo-pv01/robots.txt
  Cache-Control: public, max-age=86400, s-maxage=86400, stale-while-revalidate=3600

# ── lps-pv01 (Imersão Lucro Clínico) — servida em /lps-pv01/ ─
/lps-pv01/
  Cache-Control: public, max-age=0, must-revalidate, s-maxage=60
  X-Content-Type-Options: nosniff
  # Preload por header: o browser começa a baixar a imagem do LCP ao ler o cabeçalho,
  # sem esperar parsear o HTML. Com Early Hints ligado na zona, o Cloudflare promove
  # estes Link a uma resposta 103 e o download começa antes até do TTFB do 200.
  # Os mesmos preloads existem no <head>; o browser deduplica por URL.
  Link: </p/lps-pv01/assets/img/bg-03-2-2-740.webp>; rel=preload; as=image; imagesrcset="/p/lps-pv01/assets/img/bg-03-2-2-412.webp 412w, /p/lps-pv01/assets/img/bg-03-2-2-620.webp 620w, /p/lps-pv01/assets/img/bg-03-2-2-740.webp 740w, /p/lps-pv01/assets/img/bg-03-2-2-800.webp 800w"; imagesizes="100vw"; media="(max-width: 767px)"; fetchpriority="high"
  Link: </p/lps-pv01/assets/img/bg-03-1-2-1280.webp>; rel=preload; as=image; imagesrcset="/p/lps-pv01/assets/img/bg-03-1-2-1280.webp 1280w, /p/lps-pv01/assets/img/bg-03-1-2-1920.webp 1920w"; imagesizes="100vw"; media="(min-width: 768px)"; fetchpriority="high"
  # NÃO adicionar preload do fbevents.js aqui: `as=script` entra como prioridade ALTA
  # e rouba o cano de 1,6Mbps da imagem do LCP. Medido (Lighthouse simulate, régua do
  # PSI): com o preload, Performance despenca 95 → 58 (LCP 2,6s → 7,5s). O /tr?ev=PageView
  # melhora (2.683ms → 1.457ms slow4G), mas o preço em PageSpeed é inaceitável.
  # O preconnect abaixo fica: economiza DNS+TLS sem consumir banda.
  Link: </p/lps-pv01/assets/fonts/Sora-Regular-v2.woff2>; rel=preload; as=font; type="font/woff2"; crossorigin, <https://connect.facebook.net>; rel=preconnect

/lps-pv01/assets/*
  Cache-Control: public, max-age=31536000, immutable
  X-Content-Type-Options: nosniff
